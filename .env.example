# `npm run setup` copia este arquivo para .env preenchendo os segredos aleatórios.

# Banco (cluster local do projeto em .pgdata/, porta própria)
DATABASE_URL=postgres://amora:__DB_PASSWORD__@127.0.0.1:54329/amora
TEST_DATABASE_URL=postgres://amora:__DB_PASSWORD__@127.0.0.1:54329/amora_test

# Autenticação
BETTER_AUTH_SECRET=__BETTER_AUTH_SECRET__
BETTER_AUTH_URL=http://localhost:3000

# Login com Google (opcional: sem isso o botão não aparece)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Criptografia por campo. 32 bytes em base64. Perder esta chave = perder os textos.
# Guarde uma cópia separada do backup do banco.
DATA_ENCRYPTION_KEY=__DATA_ENCRYPTION_KEY__

# E-mail (sem SMTP_URL, os links são impressos no console, só em desenvolvimento)
SMTP_URL=
EMAIL_FROM=Amora <nao-responda@amora.local>

# Notificações push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=__VAPID_PUBLIC__
VAPID_PRIVATE_KEY=__VAPID_PRIVATE__
VAPID_SUBJECT=mailto:contato@amora.local

# Busca de livros (opcional: sem chave usa só a Open Library)
GOOGLE_BOOKS_API_KEY=

# Pasta dos arquivos enviados (capas e fotos), fora de public/
STORAGE_DIR=./storage
